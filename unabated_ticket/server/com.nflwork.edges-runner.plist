<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unabated Ticket server runner (127.0.0.1:8095) as a launchd agent next
       to the bets service: the phone page's Edges list and the Bet Tracker's
       Live tab, whose kickoff chances it can only keep while it runs before
       each game's start. Install/restart/remove: unabated_ticket/README.md
       "Bet Tracker". Paths point at the main checkout, never a worktree. -->
  <key>Label</key>
  <string>com.nflwork.edges-runner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/callancapitolo/NFLWork/unabated_ticket/server/run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- The runner logs state changes only (a scan going live, a poll failing
       or recovering), a few lines a day. -->
  <key>StandardOutPath</key>
  <string>/Users/callancapitolo/NFLWork/unabated_ticket/server/edges_runner.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/callancapitolo/NFLWork/unabated_ticket/server/edges_runner.log</string>
</dict>
</plist>
