# Unabated Ticket bets service — copy to unabated_ticket/bets_service/.env (gitignored).
# Lookup order per key: process environment, then this file, then
# <main checkout>/kalshi_draft/.env — so with the bots' credentials already in
# kalshi_draft/.env this file is optional.

# Kalshi API credentials (read-only use: fills, positions, public market/event lookups).
# https://kalshi.com/account/api-keys — same names as every bot in the repo.
KALSHI_API_KEY_ID=your_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem

# The Ticket's Place button (manual_orders.py) signs only with this key: one on
# Cal's MAIN account (no subaccount) with read + trade scope. Unset = Place is
# off (the read key above is read-only).
# KALSHI_PLACE_API_KEY_ID=place_key_id_here
# KALSHI_PLACE_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-place.pem

# The automated taker's OWN Kalshi key (server/taker.js + taker_orders.py): a key
# made for the bot alone so it can be revoked alone, locked to the bot's own
# Kalshi subaccount (1-63), whose money is all it can lose. With all three set
# and the key proven locked the bot places real Kalshi orders ($500 ceiling);
# with any missing it places none. taker_subaccount_setup.py makes the
# subaccount and the key. The Kalshi source also reads that subaccount.
# KALSHI_TAKER_API_KEY_ID=bot_key_id_here
# KALSHI_TAKER_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-taker.pem
# KALSHI_TAKER_SUBACCOUNT=1
# Stop switch: while this file exists the bot sends no order (Kalshi or Novig).
# TAKER_STOP_PATH=/absolute/path/to/taker.stop

# The automated taker on Novig (novig_taker_desk.py): its own Novig subaccount
# ($500), addressed by that subaccount's one trading key, which trades only
# there and can never move money. novig_subaccount_setup.py makes the key on
# the server and opens + funds the subaccount from the Mac's management key
# (~/.novig, never here). Key id set + key file present + Novig confirming a
# trading key = the bot places real Novig orders; else none.
# NOVIG_TAKER_KEY_ID=bot_trading_key_id_here
# NOVIG_TAKER_PRIVATE_KEY_PATH=/absolute/path/to/novig_bot.pem
# Its own stop switch (the setup creates it; rm to start trading).
# NOVIG_TAKER_STOP_PATH=/absolute/path/to/novig_taker.stop
# The Novig Place button's subaccount (read as source novig_place, and the
# Ticket's Novig Place button places from it, once set).
# NOVIG_PLACE_KEY_ID=place_trading_key_id_here
# NOVIG_PLACE_PRIVATE_KEY_PATH=/absolute/path/to/novig_place.pem
# NOVIG_API_URL=https://api.novig.com

# HTTP port on 127.0.0.1 (the extension's manifest host permission must match).
BETS_SERVICE_PORT=8094

# /bets.json window: open bets plus settled/closed ones within this many days (?days= overrides).
BETS_RETENTION_DAYS=30

# How long a source_runs row is kept (only the latest run per source is read; 0 = never prune).
BETS_SOURCE_RUNS_RETENTION_DAYS=7

# Kalshi cadence: fills + positions poll, and the full fills re-pull (reconcile).
BETS_KALSHI_POLL_SEC=60
BETS_KALSHI_RECONCILE_SEC=3600

# Novig (#116): no key here — run
#   python -m unabated_ticket.bets_service.sources.novig_auth connect
# once; it logs you in and saves a refresh token to NOVIG_TOKEN_PATH (gitignored).
# NOVIG_TOKEN_PATH=/absolute/path/to/novig_token.json
BETS_NOVIG_POLL_SEC=60
# BetOnline (#115): refresh token + Cloudflare cookies written by bet_logger/recon_betonline.py
# (default: <main checkout>/bet_logger/recon_betonline_cookies.json); report poll cadence and window.
BETS_BETONLINE_COOKIES_PATH=/Users/you/NFLWork/bet_logger/recon_betonline_cookies.json
BETS_BETONLINE_POLL_SEC=300
BETS_BETONLINE_HISTORY_DAYS=31

# BFA (2026-09-23): no key here — the source logs in with BFA_USERNAME / BFA_PASSWORD
# from <main checkout>/bet_logger/.env (the sheet scraper's own login); poll 300 s
# and the 31-day window are constants. Set the two names here only to override.
# Wagerzon (2026-09-23): likewise WAGERZONC_USERNAME / WAGERZONC_PASSWORD, else
# WAGERZON_USERNAME / WAGERZON_PASSWORD, from bet_logger/.env; poll 300 s, 6 weeks.
# Polymarket US (2026-09-23, the CFTC app, not polymarket.com): the account's own API key,
# created at https://polymarket.us/developer (the Secret Key is shown once). Keep both in
# <main checkout>/bet_logger/.env; set them here only to override. Poll 60 s, 31-day window.
# POLYMARKET_US_KEY_ID=your_key_id_uuid
# POLYMARKET_US_SECRET_KEY=base64_secret_key
# Bet105 (2026-09-29): nothing here. The extension reads it from your own login in
# Chrome (every 5 min while the panel is open) and POSTs it to /bet105.json.

# Logging (rotating file next to this package).
BETS_SERVICE_LOG_LEVEL=INFO
