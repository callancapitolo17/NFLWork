# Copy to unabated_ticket/deploy/.env on the VM (gitignored) and fill in.
# docker compose reads this file for the ${...} values in compose.yaml.
# Paths and host names only: API keys stay in unabated_ticket/bets_service/.env.

# The Tailscale MagicDNS name of this VM (`tailscale status --json | jq -r .Self.DNSName`,
# without the trailing dot). Comma-separate several. Lowercase, no https://, no port.
BETS_EXTRA_ALLOWED_HOSTS=mlb-stack.tail1234.ts.net

# Writable directory on the host for bets.duckdb, novig_token.json (its refresh
# token rotates, so the service rewrites it) and logs/. deploy.sh creates it (mode 700).
UNABATED_DATA_DIR=/home/ubuntu/unabated-data

# The Kalshi private key (.pem) on the host, mounted read-only into the container.
# Its key id goes in unabated_ticket/bets_service/.env as KALSHI_API_KEY_ID.
KALSHI_PEM_PATH=/home/ubuntu/unabated-secrets/kalshi.pem

# The host user the containers run as, so the files they write belong to it
# and the chmod 600 credential files stay readable (`id -u` / `id -g`).
DEPLOY_UID=1000
DEPLOY_GID=1000
