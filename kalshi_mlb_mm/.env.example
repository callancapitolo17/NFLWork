# Book-consensus gate (v1 correlation defense):
#   BOOK_CONSENSUS_BAND = max distance from median (in fair-prob units) for a
#     book to count as "agreeing".
#   MIN_AGREEING_BOOKS  = how many agreeing books required before we quote.
# See README "Pricing" and spec section 13.
BOOK_CONSENSUS_BAND=0.02
MIN_AGREEING_BOOKS=3
NOTIFY_WEBHOOK_URL=
# #103 Phase 3: keep a Kalshi game in mlb_target_lines only if it starts within
# this many hours — the one bound structure warming inherits. 0 disables the
# window (WARNING every cycle); negative is an error.
TARGET_LINE_HORIZON_HOURS=24
